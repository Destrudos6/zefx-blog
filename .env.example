# ============================================================
# Backblaze B2 + Cloudflare Worker 配置
# ============================================================
# 复制此文件为 .env 并填入实际值：cp .env.example .env
#
# 注意：这些变量仅在构建时（服务端）使用，不会暴露到客户端。
# 在 Cloudflare Pages 部署时，请在项目设置中配置这些环境变量。

# 是否启用 B2 远程数据拉取（开发环境可设为 false 使用本地文件）
USE_B2=false

# Cloudflare Worker 代理地址（媒体资源走 CDN）
# 格式：https://your-worker.your-domain.workers.dev
# 或使用自定义域名：https://media.yourdomain.com
B2_PROXY_URL=

# Backblaze B2 存储桶名称
B2_BUCKET_NAME=

# 存储桶中的路径前缀（如果所有资源放在一个桶的不同目录下）
# 例如：zefx-data 或留空表示根目录
B2_PREFIX=
