---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Ticker from '../components/Ticker.astro';
import LatestPost from '../components/LatestPost.astro';
import ProjectCard from '../components/ProjectCard.astro';
import About from '../components/About.astro';
import Friends from '../components/Friends.astro';
import Footer from '../components/Footer.astro';
import BackToTop from '../components/BackToTop.astro';
import { getAllPostsFromCollection, getAllProjects } from '../data/content';
import { getFriendLinks, getTickerItems, getAboutData } from '../data/backblaze';

const allPosts = await getAllPostsFromCollection();
const latest = allPosts[0] ?? null;
const secondLatest = allPosts[1] ?? null;
const thirdLatest = allPosts[2] ?? null;
const friendLinks = await getFriendLinks();
const tickerItems = await getTickerItems();
const aboutData = await getAboutData();
const allProjects = await getAllProjects();
const projectMap = Object.fromEntries(allProjects.map(p => [p.slug, p]));

// 统计近两个月每日发帖数（按东八区日期），供首页"关于站主"右侧热力图使用
// 产出 { ts: count }，ts 为两个月每日东八区零点对应的 UTC 时间戳；先铺满两个月的每一天，
// 再累加这两个月的帖子，保证前端能渲染完整月历（含零发帖日）
const postCalendar: Record<string, number> = {};
const nowCST = new Date(Date.now() + 8 * 3600 * 1000);
const year = nowCST.getUTCFullYear();
const month = nowCST.getUTCMonth(); // 0-11，当前月
// 上一个月（跨年处理）
const prevYear = month === 0 ? year - 1 : year;
const prevMonth = month === 0 ? 11 : month - 1;
// 先铺满上个月
const prevDays = new Date(Date.UTC(prevYear, prevMonth + 1, 0)).getUTCDate();
for (let d = 1; d <= prevDays; d++) {
  const ts = Math.floor((Date.UTC(prevYear, prevMonth, d, 0, 0, 0) - 8 * 3600 * 1000) / 1000);
  postCalendar[ts] = 0;
}
// 再铺满当前月
const daysInMonth = new Date(Date.UTC(year, month + 1, 0)).getUTCDate();
for (let d = 1; d <= daysInMonth; d++) {
  const ts = Math.floor((Date.UTC(year, month, d, 0, 0, 0) - 8 * 3600 * 1000) / 1000);
  postCalendar[ts] = 0;
}
for (const p of allPosts) {
  const m = /^(\d{4})\.(\d{2})\.(\d{2})/.exec(p.date || '');
  if (!m) continue;
  const py = +m[1], pm = +m[2] - 1, pd = +m[3];
  // 只统计上个月与当前月（跨年场景：prevYear/prevMonth 可能属于前一年）
  const inPrev = py === prevYear && pm === prevMonth;
  const inCurr = py === year && pm === month;
  if (!inPrev && !inCurr) continue;
  const ts = Math.floor((Date.UTC(py, pm, pd, 0, 0, 0) - 8 * 3600 * 1000) / 1000);
  postCalendar[ts] = (postCalendar[ts] || 0) + 1;
}
---

<BaseLayout>
  <Header />
  <Hero hotPosts={allPosts.map(p => {
    // 文章封面缺失但关联项目时，回退到项目封面（与项目卡片/详情页同一路径规则）
    const fallbackCover = p.project && projectMap[p.project]
      ? projectMap[p.project].coverImage || `projects/${projectMap[p.project].slug}/cover.png`
      : undefined;
    return {
      slug: p.slug, title: p.title, category: p.category, categoryColor: p.categoryColor,
      categoryTextColor: p.categoryTextColor, excerpt: p.excerpt, coverColor: p.categoryColor,
      coverImage: p.coverImage || fallbackCover,
      project: p.project ? projectMap[p.project] ?? null : null,
    };
  })} />
  <Ticker items={tickerItems} />

  <section class="section" id="posts">
    <div class="sec-head reveal">
      <h2>最新<span class="hl">文章</span></h2>
      <a class="sec-link" href="/posts">全部 {allPosts.length} 篇 →</a>
    </div>
    <div class="latest-grid">
      {latest && (
        <LatestPost
          category={latest.category}
          categoryColor={latest.categoryColor}
          categoryTextColor={latest.categoryTextColor}
          date={latest.date}
          title={latest.title}
          excerpt={latest.excerpt}
          readTime={latest.readTime}
          comments={latest.comments}
          href={`/posts/${latest.slug}`}
          coverImage={latest.coverImage || (latest.project && projectMap[latest.project]
            ? projectMap[latest.project].coverImage || `projects/${projectMap[latest.project].slug}/cover.png`
            : undefined)}
          project={latest.project ? projectMap[latest.project] ?? null : null}
        />
      )}
      {secondLatest && (
        <LatestPost
          category={secondLatest.category}
          categoryColor={secondLatest.categoryColor}
          categoryTextColor={secondLatest.categoryTextColor}
          date={secondLatest.date}
          title={secondLatest.title}
          excerpt={secondLatest.excerpt}
          readTime={secondLatest.readTime}
          comments={secondLatest.comments}
          href={`/posts/${secondLatest.slug}`}
          coverImage={secondLatest.coverImage || (secondLatest.project && projectMap[secondLatest.project]
            ? projectMap[secondLatest.project].coverImage || `projects/${projectMap[secondLatest.project].slug}/cover.png`
            : undefined)}
          project={secondLatest.project ? projectMap[secondLatest.project] ?? null : null}
        />
      )}
      {thirdLatest && (
        <LatestPost
          category={thirdLatest.category}
          categoryColor={thirdLatest.categoryColor}
          categoryTextColor={thirdLatest.categoryTextColor}
          date={thirdLatest.date}
          title={thirdLatest.title}
          excerpt={thirdLatest.excerpt}
          readTime={thirdLatest.readTime}
          comments={thirdLatest.comments}
          href={`/posts/${thirdLatest.slug}`}
          coverImage={thirdLatest.coverImage || (thirdLatest.project && projectMap[thirdLatest.project]
            ? projectMap[thirdLatest.project].coverImage || `projects/${projectMap[thirdLatest.project].slug}/cover.png`
            : undefined)}
          project={thirdLatest.project ? projectMap[thirdLatest.project] ?? null : null}
        />
      )}
    </div>
  </section>

  <section class="section" id="projects" style="padding-top:20px">
    <div class="sec-head reveal">
      <h2>项<span class="hl">目</span></h2>
      <p style="color:var(--soft); font-size:15.5px; margin-top:6px">开一个文件夹,专注做一件事。长线任务、学习计划、独立开发……这里记录每个项目的从零到一。</p>
    </div>
    <div class="projects-grid">
      {allProjects.slice(0, 3).map(project => (
        <a class="project-link" href={`/projects/${project.slug}`}>
          <ProjectCard
            title={project.title}
            status={project.status}
            statusLabel={project.statusLabel}
            description={project.description}
            logs={project.logs.slice(0, 2)}
            tags={project.tags}
            coverImage={project.coverImage || `projects/${project.slug}/cover.png`}
          />
        </a>
      ))}
    </div>
  </section>

  <About data={aboutData} postCalendar={postCalendar} heatmapYear={prevYear} heatmapMonth={prevMonth} />
  <Friends links={friendLinks} />
  <Footer />
  <BackToTop />
</BaseLayout>

<style>
  .project-link { text-decoration: none; color: inherit; }
  .latest-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  @media (max-width: 1000px) {
    .latest-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
