---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BackToTop from '../../components/BackToTop.astro';
import Cover from '../../components/Cover.astro';
import Giscus from '../../components/Giscus.astro';
import { getAllProjects, getProjectPosts } from '../../data/content';
import { getMediaUrl, getPostCoverPath } from '../../utils/media';

export async function getStaticPaths() {
  const allProjects = await getAllProjects();
  const projectMap = Object.fromEntries(allProjects.map(p => [p.slug, p]));
  return allProjects.map(project => ({
    params: { slug: project.slug },
    props: { project, projectMap },
  }));
}

const { project, projectMap } = Astro.props;
const projectPosts = await getProjectPosts(project.slug);

const statusIcon = project.status === 'active' ? '▶' : project.status === 'done' ? '✓' : '⏸';
const coverPath = project.coverImage || `projects/${project.slug}/cover.png`;
const ogImage = getMediaUrl(coverPath);
---

<BaseLayout title={`${project.title} · ZEFX`} ogImage={ogImage}>
  <Header />

  <div class="back-link reveal">
    <a class="btn" href="/projects" data-back-link>← 返回</a>
  </div>

  <div class="project-hero reveal">
    <div class="project-hero-inner">
      <span class="project-status-badge">
        <span class="status-icon">{statusIcon}</span>
        {project.statusLabel}
      </span>
      <h1>{project.title}</h1>
      <p class="project-desc">{project.description}</p>
      <div class="project-tags">
        {project.tags.map(t => (
          <span class="tag">{t}</span>
        ))}
      </div>
    </div>
    <Cover src={ogImage} alt={project.title} class="project-hero-cover" loading="eager" />
  </div>

  <section class="section" style="padding-top:20px">
    {project.logs.length > 0 && (
      <div class="log-section reveal">
        <h2>项目<span class="hl">日志</span></h2>
        <div class="log-timeline">
          {project.logs.map((u, i) => (
            <div class="log-entry" style={`--d:.${i * 8}s`}>
              <div class="log-dot"></div>
              <div class="log-content">
                <time>{u.date}</time>
                <p>{u.text}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    )}

    {projectPosts.length > 0 ? (
      <div class="posts-section reveal" style="margin-top:48px">
        <h2>项目<span class="hl">文章</span></h2>
        <div class="project-posts">
          {projectPosts.map((post, i) => {
            const coverPath = getPostCoverPath(post, projectMap);
            const coverImage = coverPath ? getMediaUrl(coverPath) : null;
            return (
            <article class="proj-post reveal" style={`--ac:${post.categoryColor}; ${post.categoryTextColor ? `--actext:${post.categoryTextColor}` : ''}; --cover-bg:${post.categoryColor}; --d:.${(i + 1) * 8}s`}>
              <Cover src={coverImage} alt={post.title} class="proj-post-cover" icon="📸" label={`IMG_${String(i + 1).padStart(4, '0')}`} />
              <div class="proj-post-right">
                <div class="proj-post-meta-row">
                  <time>{post.date}</time>
                  <span class="cat">{post.category}</span>
                </div>
                <h3><a href={`/posts/${post.slug}`}>{post.title}</a></h3>
                <p>{post.excerpt}</p>
                <div class="proj-post-meta">
                  <span class="mono">{post.readTime} · <span data-comment-slug={post.slug}>{post.comments}</span> 评论</span>
                  <span class="go">→</span>
                </div>
              </div>
            </article>
            );
          })}
        </div>
      </div>
    ) : (
      <div class="empty-state reveal" style="margin-top:48px">
        <p>这个项目还没有关联文章。写了会贴上来的。</p>
      </div>
    )}
  </section>

  <Giscus />
  <Footer />
  <BackToTop />
</BaseLayout>

<style>
  .project-hero {
    max-width: 1200px;
    margin: 0 auto;
    padding: 48px 24px 0;
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 48px;
    align-items: start;
  }
  .project-hero-inner { padding-top: 20px; }
  .project-status-badge {
    display: inline-flex; align-items: center; gap: 8px;
    font-family: var(--mono); font-size: 12px; font-weight: 700;
    padding: 6px 14px; border: var(--bd); background: var(--card);
    box-shadow: 3px 3px 0 var(--ink); margin-bottom: 20px;
  }
  .status-icon { font-size: 10px; }
  .project-hero h1 {
    font-family: var(--serif); font-weight: 900;
    font-size: clamp(32px, 4.5vw, 52px); line-height: 1.2;
    display: block; margin-bottom: 16px;
  }
  .project-desc {
    font-size: 17px; color: var(--soft);
    line-height: 1.7; margin-bottom: 20px; max-width: 32em;
  }
  .tag {
    font-family: var(--mono); font-size: 11.5px;
    color: var(--red); background: var(--paper);
    border: var(--bd); padding: 2px 10px; font-weight: 700;
  }

  .log-section h2, .posts-section h2 {
    font-family: var(--serif); font-weight: 900;
    font-size: clamp(24px, 3vw, 34px); margin-bottom: 28px;
  }
  .log-timeline {
    position: relative; padding-left: 36px;
  }
  .log-timeline::before {
    content: ""; position: absolute;
    left: 9px; top: 0; bottom: 0;
    width: 2px; background: var(--ink); opacity: .15;
  }
  .log-entry { position: relative; margin-bottom: 24px; }
  .log-dot {
    position: absolute; left: -36px; top: 4px;
    width: 20px; height: 20px; border-radius: 50%;
    background: var(--lemon); border: 3px solid var(--ink);
    box-shadow: 2px 2px 0 var(--ink);
  }
  .log-content time {
    font-family: var(--mono); font-size: 12px;
    color: var(--soft); letter-spacing: .1em;
    display: block; margin-bottom: 4px;
  }
  .log-content p { font-size: 15px; line-height: 1.6; }

  .project-posts { display: flex; flex-direction: column; gap: 0; }
  .proj-post {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 24px; padding: 24px 0;
    border-bottom: 2px dashed rgba(128,128,128,.25);
    transition: background .2s;
  }
  .proj-post:last-child { border-bottom: none; }
  .proj-post:hover .proj-post-cover { transform: translate(-2px,-2px); box-shadow: 5px 5px 0 var(--ac); }
  .proj-post:hover { background: var(--card); }
  .proj-post-meta-row {
    display: flex; align-items: center; gap: 12px;
    margin-bottom: 10px; padding-top: 2px;
  }
  .proj-post-meta-row time {
    font-family: var(--mono); font-size: 12px;
    color: var(--soft); letter-spacing: .08em;
  }
  .cat {
    background: var(--ac); color: var(--actext, #fff);
    border: var(--bd); padding: 2px 9px;
    font-size: 11px; font-weight: 700; letter-spacing: .06em;
    box-shadow: 2px 2px 0 var(--ink); width: fit-content;
  }
  .proj-post-right h3 {
    font-family: var(--serif); font-weight: 700;
    font-size: 20px; line-height: 1.5; margin-bottom: 8px;
  }
  .proj-post-right h3 a:hover {
    background-image: linear-gradient(transparent 72%, var(--lemon) 72%);
  }
  .proj-post-right p {
    font-size: 14.5px; color: var(--soft); line-height: 1.6;
    display: -webkit-box; -webkit-line-clamp: 2;
    -webkit-box-orient: vertical; overflow: hidden;
    margin-bottom: 10px;
  }
  .proj-post-meta {
    display: flex; justify-content: space-between; align-items: center;
  }
  .proj-post-meta .mono { font-size: 12px; color: var(--soft); }
  .go {
    width: 30px; height: 30px;
    display: grid; place-items: center;
    border: var(--bd); border-radius: 50%;
    font-size: 14px; font-weight: 700; transition: .28s;
  }
  .proj-post:hover .go {
    background: var(--ac); color: var(--actext, #fff);
    transform: translateX(4px) rotate(-45deg);
  }

  .empty-state p {
    font-family: var(--mono); font-size: 14px;
    color: var(--soft); padding: 24px 0;
    border-top: 2px dashed rgba(128,128,128,.25);
  }

  .back-link { max-width: 1200px; margin: 0 auto; padding: 48px 24px 16px; }
  .btn {
    display: inline-flex; align-items: center; gap: 10px; cursor: pointer;
    background: var(--red); color: #fff; border: var(--bd); padding: 12px 24px;
    font-weight: 700; font-size: 15px; box-shadow: 5px 5px 0 var(--ink);
    transition: transform .2s, box-shadow .2s;
  }
  .btn:hover { transform: translate(-2px,-2px); box-shadow: 7px 7px 0 var(--ink); }

  @media (max-width: 1000px) {
    .project-hero { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .proj-post { grid-template-columns: 1fr; gap: 12px; }
    .proj-post-cover { max-width: 100%; }
    .project-hero { padding: 40px 18px 0; }
    .project-hero h1 { font-size: clamp(26px, 7vw, 36px); }
    .project-desc { font-size: 15px; }
  }
</style>
