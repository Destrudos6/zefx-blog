---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Friends from "../components/Friends.astro";
import Footer from "../components/Footer.astro";
import BackToTop from "../components/BackToTop.astro";
import { getFriendLinks } from "../data/backblaze";

const friends = await getFriendLinks();
---

<BaseLayout title="友链 · ZEFX">
    <Header />

    <div class="page-banner reveal">
        <h1>友链 · 还在认真写博客的<span class="hl">友友</span></h1>
        <p class="page-desc">
            无论是记录生活、传递美好，还是分享技术，文字都是拉近我们内心距离的方式。如果你也在写,欢迎交换友链。
        </p>
    </div>

    <section class="section" style="padding-top:0">
        <Friends links={friends} variant="detailed" />
    </section>

    <Footer />
    <BackToTop />
</BaseLayout>
