---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BackToTop from '../../components/BackToTop.astro';
import MobileActions from '../../components/MobileActions.astro';
import Giscus from '../../components/Giscus.astro';
import { getCollection, render } from 'astro:content';
import { getMediaUrl } from '../../utils/media';

const allProjects = await getCollection('projects');
const projectMap = Object.fromEntries(allProjects.map(p => [p.id.split('/')[0], p]));

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return await Promise.all(posts.map(async (post) => {
    const { Content, headings } = await render(post);
    const toc = headings
      .filter(h => h.depth >= 2 && h.depth <= 3)
      .map(h => ({ id: h.slug, text: h.text, level: h.depth }));
    return {
      params: { slug: post.id },
      props: { post, toc, Content },
    };
  }));
}

const { post, toc, Content } = Astro.props;
const projectInfo = post.data.project ? projectMap[post.data.project] : null;
---

<BaseLayout title={`${post.data.title} · ZEFX`} ogImage={post.data.coverImage ? getMediaUrl(post.data.coverImage) : undefined}>
  <Header />
  <div class="article-page">
  <a class="back-bar reveal" href="/posts" onclick="event.preventDefault();if(window.history.length>1){window.history.back()}else{window.location.href='/posts'}">← 返回</a>
  <div class="article-header reveal">
    <div class="article-meta">
        <span class="cat" style={`--ac:${post.data.categoryColor}; ${post.data.categoryTextColor ? `--actext:${post.data.categoryTextColor}` : ''}`}>{post.data.category}</span>
        {projectInfo && (
          <span class="project-tag" style={`--pc:${projectInfo.data.coverColor}`}>{projectInfo.data.title}</span>
        )}
        <time>{post.data.date}</time>
        <span class="mono dim">{post.data.readTime} · <span data-comment-slug={post.id}>{post.data.comments}</span> 评论</span>
      </div>
      <h1>{post.data.title}</h1>
      <p class="article-excerpt">{post.data.excerpt}</p>
    </div>

    <div class="article-body">
      {toc.length > 0 && (
        <aside class="toc reveal">
          <div class="toc-inner">
            <h4 class="toc-title">目录</h4>
            <nav class="toc-nav">
              {toc.map(h => (
                <a class={`toc-item toc-h${h.level}`} href={`#${h.id}`}>{h.text}</a>
              ))}
            </nav>
          </div>
        </aside>
      )}

      <article class="article-content"><Content /></article>
    </div>
  </div>

  <Giscus />
  <Footer />
  <BackToTop />
  <MobileActions hasToc={toc.length > 0} hasComments={true} />
</BaseLayout>

<style>
  .article-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 16px 24px 0;
  }

  .article-header {
    padding: 40px 0 48px;
    border-bottom: 3px solid var(--ink);
    margin-bottom: 48px;
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }

  .cat {
    background: var(--ac); color: var(--actext, #fff);
    border: var(--bd); padding: 3px 12px;
    font-size: 12px; font-weight: 700; letter-spacing: .08em;
    box-shadow: 2px 2px 0 var(--ink);
  }

  .article-meta time {
    font-family: var(--mono); font-size: 13px; color: var(--soft);
  }

  .article-header h1 {
    font-family: var(--serif); font-weight: 900;
    font-size: clamp(28px, 4.5vw, 48px);
    line-height: 1.3;
    display: block;
    margin-bottom: 16px;
  }

  .article-excerpt {
    font-size: 17px; color: var(--soft);
    line-height: 1.7; max-width: 40em;
  }

  .article-body {
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: 48px;
    align-items: start;
    padding-bottom: 80px;
  }

  .toc {
    position: sticky;
    top: 100px;
    max-height: calc(100vh - 120px);
    overflow-y: auto;
  }

  .toc-inner {
    border: var(--bd);
    background: var(--card);
    box-shadow: 4px 4px 0 var(--ink);
    padding: 20px 20px;
    overflow: hidden;
  }

  .toc-title {
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .2em;
    color: var(--red);
    margin-bottom: 14px;
    padding-bottom: 10px;
    border-bottom: 2px dashed var(--ink);
  }

  .toc-nav {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .toc-item {
    display: block;
    font-size: 13.5px;
    line-height: 1.5;
    padding: 6px 0;
    color: var(--soft);
    border-bottom: 1px dashed rgba(128,128,128,.2);
    transition: color .2s, padding-left .2s;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .toc-item:last-child { border-bottom: none; }

  .toc-item:hover {
    color: var(--red);
    padding-left: 6px;
  }

  .toc-item.active {
    color: var(--red);
    font-weight: 700;
    padding-left: 6px;
  }

  .toc-h3 {
    padding-left: 14px;
    font-size: 12.5px;
  }

  .article-content {
    max-width: 680px;
    font-size: 17px;
    line-height: 1.9;
  }

  .article-content :global(img) {
    max-width: 100%;
    height: auto;
    border: var(--bd);
    box-shadow: 4px 4px 0 var(--ink);
    margin: 24px 0;
  }

  .article-content :global(h2) {
    font-family: var(--serif);
    font-weight: 900;
    font-size: clamp(22px, 2.8vw, 30px);
    margin: 56px 0 20px;
    padding-bottom: 10px;
    border-bottom: 3px solid var(--ink);
  }

  .article-content :global(h3) {
    font-family: var(--serif);
    font-weight: 700;
    font-size: clamp(18px, 2.2vw, 24px);
    margin: 40px 0 16px;
  }

  .article-content :global(p) {
    margin-bottom: 24px;
  }

  .article-content :global(pre) {
    background: var(--ink);
    color: var(--paper);
    padding: 24px;
    border: var(--bd);
    overflow-x: auto;
    font-family: var(--mono);
    font-size: 14px;
    line-height: 1.6;
    margin-bottom: 24px;
    box-shadow: 6px 6px 0 rgba(0,0,0,.15);
  }

  .article-content :global(code) {
    font-family: var(--mono);
    font-size: 0.88em;
    background: var(--card);
    border: 1px solid var(--ink);
    padding: 2px 6px;
  }

  .article-content :global(pre) :global(code) {
    background: none;
    border: none;
    padding: 0;
  }

  .article-content :global(blockquote) {
    border-left: 4px solid var(--red);
    padding: 20px 28px;
    margin: 32px 0;
    background: var(--card);
    border: var(--bd);
    border-left: 6px solid var(--red);
    font-style: italic;
    color: var(--soft);
    box-shadow: 4px 4px 0 var(--ink);
  }

  .article-content :global(strong) {
    font-weight: 700;
    color: var(--ink);
  }

  .article-content :global(ul),
  .article-content :global(ol) {
    padding-left: 28px;
    margin-bottom: 24px;
  }

  .article-content :global(li) {
    margin-bottom: 8px;
    line-height: 1.8;
  }

  .article-content :global(li) :global(ul),
  .article-content :global(li) :global(ol) {
    margin: 8px 0 0;
  }

  .back-bar {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    margin-bottom: 28px;
    padding: 8px 24px;
    border: var(--bd);
    background: var(--card);
    box-shadow: 4px 4px 0 var(--ink);
    font-family: var(--mono);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: .06em;
    color: var(--soft);
    text-decoration: none;
    transition: transform .2s, box-shadow .2s, color .2s;
  }

  .back-bar:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 var(--ink);
    color: var(--red);
  }

  @media (max-width: 1000px) {
    .article-body {
      grid-template-columns: 1fr;
    }
    .toc {
      position: static;
    }
    .toc-inner {
      display: flex;
      flex-wrap: wrap;
      gap: 0;
      align-items: baseline;
    }
    .toc-title {
      margin-bottom: 0;
      padding-bottom: 0;
      border-bottom: none;
      margin-right: 12px;
      padding-top: 0;
    }
    .toc-nav {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 4px 12px;
    }
    .toc-item {
      border-bottom: none;
      padding: 4px 0;
    }
    .toc-h3 {
      padding-left: 0;
    }
  }

  @media (max-width: 768px) {
    .article-body { grid-template-columns: 1fr; gap: 24px; }
    .toc { position: static; max-height: none; }
    .toc-inner { padding: 16px; }
    .toc-nav { flex-direction: row; flex-wrap: wrap; gap: 4px 12px; }
    .toc-item { border-bottom: none; padding: 4px 0; font-size: 13px; }
    .toc-h3 { padding-left: 0; }
    .toc-title { margin-bottom: 0; padding-bottom: 0; border-bottom: none; margin-right: 12px; }
  }
  @media (max-width: 640px) {
    .article-page { padding: 16px 18px 0; }
    .article-header { padding: 40px 0 24px; margin-bottom: 32px; }
    .article-content { font-size: 16px; }
    .article-header h1 { font-size: clamp(24px, 6vw, 34px); }
    .article-excerpt { font-size: 15px; }
    .back-bar { font-size: 13px; padding: 6px 16px; }
  }
</style>
