---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BackToTop from '../../components/BackToTop.astro';
import MobileActions from '../../components/MobileActions.astro';
import Giscus from '../../components/Giscus.astro';
import Cover from '../../components/Cover.astro';
import { getCollection, render } from 'astro:content';
import { getMediaUrl, getPostCoverPath } from '../../utils/media';

const allProjects = await getCollection('projects');
const projectMap = Object.fromEntries(allProjects.map(p => [p.id.split('/')[0], p]));

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  // 与 getAllPostsFromCollection 一致：按日期倒序（新 → 旧）
  const sorted = [...posts].sort((a, b) => (b.data.date || '').localeCompare(a.data.date || ''));
  return await Promise.all(sorted.map(async (post, i) => {
    const { Content, headings } = await render(post);
    const toc = headings
      .filter(h => h.depth >= 2 && h.depth <= 3)
      .map(h => ({ id: h.slug, text: h.text, level: h.depth }));

    // 相关文章推荐：与当前文章共享标签最多的前 3 篇（排除自身）
    const myTags = new Set(post.data.tags ?? []);
    const relatedPosts = myTags.size
      ? sorted
          .filter(p => p.id !== post.id)
          .map(p => ({
            p,
            shared: (p.data.tags ?? []).filter(t => myTags.has(t)).length,
          }))
          .filter(x => x.shared > 0)
          .sort((a, b) => b.shared - a.shared || (b.p.data.date || '').localeCompare(a.p.data.date || ''))
          .slice(0, 3)
          .map(x => x.p)
      : [];

    return {
      params: { slug: post.id },
      props: {
        post,
        toc,
        Content,
        prevPost: sorted[i - 1] ?? null, // 更新的文章
        nextPost: sorted[i + 1] ?? null, // 更旧的文章
        relatedPosts,
      },
    };
  }));
}

const { post, toc, Content, prevPost, nextPost, relatedPosts } = Astro.props;
const projectInfo = post.data.project ? projectMap[post.data.project] : null;
// 文章封面缺失但关联项目时，回退到项目封面（统一规则见 getPostCoverPath）
const coverPath = getPostCoverPath(post.data, projectMap ? Object.fromEntries(allProjects.map(p => [p.id.split('/')[0], p])) : null);
const coverImage = coverPath ? getMediaUrl(coverPath) : null;
---

<BaseLayout title={`${post.data.title} · ZEFX`} ogImage={post.data.coverImage ? getMediaUrl(post.data.coverImage) : undefined}>
  <Header />
  <div class="article-page">
  <a class="back-bar reveal" href="/posts" data-back-link>← 返回</a>
  <div class="article-header reveal">
    <div class="article-header-main">
      <div class="article-meta">
          <span class="cat" style={`--ac:${post.data.categoryColor}; ${post.data.categoryTextColor ? `--actext:${post.data.categoryTextColor}` : ''}`}>{post.data.category}</span>
          {projectInfo && (
            <span class="project-tag" style={`--pc:${projectInfo.data.coverColor}`}>{projectInfo.data.title}</span>
          )}
          <time>{post.data.date}</time>
          <span class="mono dim">{post.data.readTime} · <span data-comment-slug={post.id}>{post.data.comments}</span> 评论</span>
        </div>
        <h1>{post.data.title}</h1>
        <p class="article-excerpt">{post.data.excerpt}</p>
    </div>
    <Cover
      src={coverImage}
      alt={post.data.title}
      class="article-cover"
      icon="📸"
      label={post.data.category}
      loading="eager"
    />
  </div>

    <div class="article-body">
      {toc.length > 0 && (
        <aside class="toc reveal">
          <div class="toc-inner">
            <h4 class="toc-title">目录</h4>
            <nav class="toc-nav">
              {toc.map(h => (
                <a class={`toc-item toc-h${h.level}`} href={`#${h.id}`}>{h.text}</a>
              ))}
            </nav>
          </div>
        </aside>
      )}

      <article class="article-content"><Content /></article>
    </div>

    <nav class="post-pager reveal" aria-label="上一篇 / 下一篇">
      {prevPost && (
        <a class="pager-card pager-prev" href={`/posts/${prevPost.id}`}>
          <span class="pager-kicker mono">← 上一篇</span>
          <span class="pager-title">{prevPost.data.title}</span>
          <span class="pager-meta mono">{prevPost.data.date}</span>
        </a>
      )}
      {nextPost && (
        <a class="pager-card pager-next" href={`/posts/${nextPost.id}`}>
          <span class="pager-kicker mono">下一篇 →</span>
          <span class="pager-title">{nextPost.data.title}</span>
          <span class="pager-meta mono">{nextPost.data.date}</span>
        </a>
      )}
    </nav>

    {relatedPosts.length > 0 && (
      <section class="related reveal" aria-label="相关文章">
        <h2 class="related-title">相关<span class="hl">文章</span></h2>
        <div class="related-grid">
          {relatedPosts.map(r => (
            <a class="related-card" href={`/posts/${r.id}`}>
              <span class="related-cat" style={`--ac:${r.data.categoryColor}; ${r.data.categoryTextColor ? `--actext:${r.data.categoryTextColor}` : ''}`}>{r.data.category}</span>
              <span class="related-card-title">{r.data.title}</span>
              <time class="related-meta mono">{r.data.date}</time>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>

  <Giscus />
  <Footer />
  <BackToTop />
  <MobileActions hasToc={toc.length > 0} hasComments={true} />
</BaseLayout>

<style>
  .article-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 16px 24px 0;
  }

  .article-header {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 48px;
    align-items: start;
    padding: 40px 0 48px;
    border-bottom: 3px solid var(--ink);
    margin-bottom: 48px;
  }

  .article-header-main {
    min-width: 0;
  }


  .article-meta {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }

  .cat {
    background: var(--ac); color: var(--actext, #fff);
    border: var(--bd); padding: 3px 12px;
    font-size: 12px; font-weight: 700; letter-spacing: .08em;
    box-shadow: 2px 2px 0 var(--ink);
  }

  .article-meta time {
    font-family: var(--mono); font-size: 13px; color: var(--soft);
  }

  .article-header h1 {
    font-family: var(--serif); font-weight: 900;
    font-size: clamp(28px, 4.5vw, 48px);
    line-height: 1.3;
    display: block;
    margin-bottom: 16px;
  }

  .article-excerpt {
    font-size: 17px; color: var(--soft);
    line-height: 1.7; max-width: 40em;
  }

  .article-body {
    display: grid;
    grid-template-columns: 1fr 350px;
    gap: 32px;
    align-items: start;
    padding-bottom: 80px;
  }

  /* grid 按 DOM 顺序填充列：正文在前（order 1 → 左列 1fr），目录在后（order 2 → 右列 300px） */
  .article-content {
    order: 1;
    min-width: 0;
  }
  .toc {
    order: 2;
  }

  .toc {
    position: sticky;
    top: 100px;
    max-height: calc(100vh - 120px);
    overflow-y: auto;
  }

  .toc-inner {
    border: var(--bd);
    background: var(--card);
    box-shadow: 4px 4px 0 var(--ink);
    padding: 20px 20px;
    overflow: hidden;
  }

  .toc-title {
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .2em;
    color: var(--red);
    margin-bottom: 14px;
    padding-bottom: 10px;
    border-bottom: 2px dashed var(--ink);
  }

  .toc-nav {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .toc-item {
    display: block;
    font-size: 13.5px;
    line-height: 1.5;
    padding: 6px 0;
    color: var(--soft);
    border-bottom: 1px dashed rgba(128,128,128,.2);
    transition: color .2s, padding-left .2s;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .toc-item:last-child { border-bottom: none; }

  .toc-item:hover {
    color: var(--red);
    padding-left: 6px;
  }

  .toc-item.active {
    color: var(--red);
    font-weight: 700;
    padding-left: 6px;
  }

  .toc-h3 {
    padding-left: 14px;
    font-size: 12.5px;
  }

  .article-content {
    max-width: 680px;
    font-size: 17px;
    line-height: 1.9;
  }

  .article-content :global(img) {
    max-width: 100%;
    height: auto;
    border: var(--bd);
    box-shadow: 4px 4px 0 var(--ink);
    margin: 24px 0;
  }

  .article-content :global(h2) {
    font-family: var(--serif);
    font-weight: 900;
    font-size: clamp(22px, 2.8vw, 30px);
    margin: 56px 0 20px;
    padding-bottom: 10px;
    border-bottom: 3px solid var(--ink);
  }

  .article-content :global(h3) {
    font-family: var(--serif);
    font-weight: 700;
    font-size: clamp(18px, 2.2vw, 24px);
    margin: 40px 0 16px;
  }

  .article-content :global(p) {
    margin-bottom: 24px;
  }

  /* 正文链接视觉差异化：蓝色 + 黄色下划线，悬停加深（蓝色更符合可跳转链接的惯例） */
  .article-content :global(a) {
    color: var(--blue);
    text-decoration: underline;
    text-decoration-color: var(--lemon);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
    transition: color .15s;
  }
  .article-content :global(a:hover) {
    color: var(--ink);
  }

  .article-content :global(pre) {
    background: var(--ink);
    color: var(--paper);
    padding: 24px;
    border: var(--bd);
    overflow-x: auto;
    font-family: var(--mono);
    font-size: 14px;
    line-height: 1.6;
    margin-bottom: 24px;
    box-shadow: 6px 6px 0 rgba(0,0,0,.15);
  }

  .article-content :global(code) {
    font-family: var(--mono);
    font-size: 0.88em;
    background: var(--card);
    border: 1px solid var(--ink);
    padding: 2px 6px;
  }

  .article-content :global(pre) :global(code) {
    background: none;
    border: none;
    padding: 0;
  }

  .article-content :global(blockquote) {
    border: none;
    border-left: 4px solid var(--red);
    margin: 24px 0;
    padding: 2px 0 2px 20px;
    font-style: italic;
    color: var(--soft);
  }
  /* 消除引用内段落的 margin，避免把竖线撑得比内容高 */
  .article-content :global(blockquote) :global(p) {
    margin: 0;
  }
  .article-content :global(blockquote) :global(p) + :global(p) {
    margin-top: 8px;
  }

  .article-content :global(strong) {
    font-weight: 700;
    color: var(--ink);
  }

  /* 高亮标记 ==text== → <mark>（由 mark-highlight hast 插件在构建时生成） */
  .article-content :global(mark) {
    background: var(--lemon);
    color: var(--ink);
    padding: 0 4px;
    border-radius: 2px;
  }

  .article-content :global(ul),
  .article-content :global(ol) {
    padding-left: 28px;
    margin-bottom: 24px;
  }

  .article-content :global(li) {
    margin-bottom: 8px;
    line-height: 1.8;
  }

  .article-content :global(li) :global(ul),
  .article-content :global(li) :global(ol) {
    margin: 8px 0 0;
  }

  .back-bar {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    margin-bottom: 28px;
    padding: 8px 24px;
    border: var(--bd);
    background: var(--card);
    box-shadow: 4px 4px 0 var(--ink);
    font-family: var(--mono);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: .06em;
    color: var(--soft);
    text-decoration: none;
    transition: transform .2s, box-shadow .2s, color .2s;
  }

  /* 上一篇 / 下一篇 */
  .post-pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin: 8px 0 48px;
    /* 与正文内容区等宽（.article-content 的 max-width），保持左右对齐 */
    max-width: 680px;
  }
  .pager-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px 24px;
    border: var(--bd);
    background: var(--card);
    box-shadow: 4px 4px 0 var(--ink);
    text-decoration: none;
    color: inherit;
    transition: transform .2s, box-shadow .2s, color .2s;
    min-width: 0;
  }
  /* 只有上一篇或只有下一篇时，单卡片占满整行宽度 */
  .pager-card:only-child {
    grid-column: 1 / -1;
  }
  .pager-card:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 var(--ink);
    color: var(--red);
  }
  .pager-next { text-align: right; }
  .pager-kicker {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .12em;
    color: var(--soft);
  }
  .pager-title {
    font-family: var(--serif);
    font-weight: 700;
    font-size: 18px;
    line-height: 1.45;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  .pager-meta {
    font-size: 12px;
    color: var(--soft);
  }

  /* 相关文章推荐 */
  .related {
    margin-bottom: 48px;
  }
  .related-title {
    font-family: var(--serif);
    font-weight: 900;
    font-size: clamp(22px, 2.6vw, 28px);
    margin-bottom: 20px;
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .related-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 20px;
    border: var(--bd);
    background: var(--card);
    box-shadow: 4px 4px 0 var(--ink);
    text-decoration: none;
    color: inherit;
    transition: transform .2s, box-shadow .2s;
    min-width: 0;
  }
  .related-card:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 var(--ink);
  }
  .related-cat {
    width: fit-content;
    background: var(--ac);
    color: var(--actext, #fff);
    border: var(--bd);
    padding: 2px 9px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .06em;
    box-shadow: 2px 2px 0 var(--ink);
  }
  .related-card-title {
    font-family: var(--serif);
    font-weight: 700;
    font-size: 16px;
    line-height: 1.5;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  .related-meta {
    font-size: 12px;
    color: var(--soft);
  }

  @media (max-width: 768px) {
    .related-grid {
      grid-template-columns: 1fr;
    }
  }

  .back-bar:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 var(--ink);
    color: var(--red);
  }

  @media (max-width: 1000px) {
    .article-header {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .article-body {
      grid-template-columns: 1fr;
    }
    /* 单列时目录回到正文上方，保持原来的阅读顺序 */
    .toc {
      order: -1;
    }
    .toc {
      position: static;
    }
    .toc-inner {
      display: flex;
      flex-wrap: wrap;
      gap: 0;
      align-items: baseline;
    }
    .toc-title {
      margin-bottom: 0;
      padding-bottom: 0;
      border-bottom: none;
      margin-right: 12px;
      padding-top: 0;
    }
    .toc-nav {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 4px 12px;
    }
    .toc-item {
      border-bottom: none;
      padding: 4px 0;
    }
    .toc-h3 {
      padding-left: 0;
    }
  }

  @media (max-width: 768px) {
    .article-body { grid-template-columns: 1fr; gap: 24px; }
    .toc { position: static; max-height: none; }
    .toc-inner { padding: 16px; }
    .toc-nav { flex-direction: row; flex-wrap: wrap; gap: 4px 12px; }
    .toc-item { border-bottom: none; padding: 4px 0; font-size: 13px; }
    .toc-h3 { padding-left: 0; }
    .toc-title { margin-bottom: 0; padding-bottom: 0; border-bottom: none; margin-right: 12px; }
  }
  @media (max-width: 640px) {
    .article-page { padding: 16px 18px 0; }
    .article-header { padding: 40px 0 24px; margin-bottom: 32px; }
    .article-content { font-size: 16px; }
    .article-header h1 { font-size: clamp(24px, 6vw, 34px); }
    .article-excerpt { font-size: 15px; }
    .back-bar { font-size: 13px; padding: 6px 16px; }
  }
</style>

<style is:global>
  /* 复制按钮由 JS 动态创建（无 Astro scoped 属性），样式必须全局生效 */
  .article-content pre {
    position: relative;
  }
  .article-content pre .copy-btn {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 2;
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 700;
    color: var(--paper);
    background: rgba(0, 0, 0, .55);
    border: 1px solid rgba(255, 255, 255, .35);
    padding: 4px 12px;
    cursor: pointer;
    opacity: 0;
    transition: opacity .15s, background .15s;
    line-height: 1.5;
    border-radius: 2px;
  }
  .article-content pre:hover .copy-btn,
  .article-content pre:focus-within .copy-btn {
    opacity: 1;
  }
  .article-content pre .copy-btn:hover {
    background: var(--red);
    border-color: var(--red);
  }
  .article-content pre .copy-btn.copied {
    background: var(--green);
    border-color: var(--green);
  }
</style>

<script>
  // 为文章正文的每个代码块注入右上角复制按钮（悬停/聚焦时显示）
  (function () {
    const pres = document.querySelectorAll('.article-content pre');
    if (!pres.length) return;

    pres.forEach((pre) => {
      // 跳过已经注入过按钮的代码块（防止重复执行）
      if (pre.querySelector('.copy-btn')) return;

      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'copy-btn mono';
      btn.textContent = '复制';
      btn.setAttribute('aria-label', '复制代码');

      btn.addEventListener('click', async () => {
        const code = pre.querySelector('code');
        const text = code ? code.innerText : pre.innerText;
        try {
          await navigator.clipboard.writeText(text);
          btn.textContent = '已复制 ✓';
          btn.classList.add('copied');
        } catch {
          // 剪贴板 API 不可用时回退到 textarea 复制
          const ta = document.createElement('textarea');
          ta.value = text;
          document.body.appendChild(ta);
          ta.select();
          try {
            document.execCommand('copy');
            btn.textContent = '已复制 ✓';
            btn.classList.add('copied');
          } catch {
            btn.textContent = '复制失败';
          }
          ta.remove();
        }
        setTimeout(() => {
          btn.textContent = '复制';
          btn.classList.remove('copied');
        }, 1500);
      });

      pre.appendChild(btn);
    });
  })();
</script>
