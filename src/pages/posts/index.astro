---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BackToTop from '../../components/BackToTop.astro';
import PostCard from '../../components/PostCard.astro';
import { POSTS_PER_PAGE, getPostsPageData } from '../../data/content';

const { allPosts, projectMap, postsTagline, categories, catMap, totalPages } = await getPostsPageData();
const firstPagePosts = allPosts.slice(0, POSTS_PER_PAGE);
const coverColors = ['var(--blue)', 'var(--green)', 'var(--red)', 'var(--orange)'];
---

<BaseLayout title="文章 · ZEFX">
  <Header />

  <div class="page-banner reveal">
    <h1>全部<span class="hl">文章</span></h1>
    <p class="page-desc">{allPosts.length} 篇手打文字,{postsTagline}</p>
  </div>

  <section class="section" style="padding-top:0">
    <div class="cats reveal">
      {categories.map(cat => (
        <button type="button" class={`cat-btn${cat.active ? ' on' : ''}`} aria-pressed={cat.active ? 'true' : 'false'} data-label={cat.label}>{cat.label} {cat.count}</button>
      ))}
    </div>

    <div class="posts-grid" id="posts-grid">
      {firstPagePosts.map((post, i) => (
        <PostCard post={post} projectMap={projectMap} color={coverColors[i % coverColors.length]} index={i} />
      ))}
    </div>

    {totalPages > 1 && (
      <nav class="pagination reveal">
        <span class="page-info mono">第 1 页 / 共 {totalPages} 页</span>
        <a class="page-btn" href="/posts/2">下一页 →</a>
      </nav>
    )}
  </section>

  <Footer />
  <BackToTop />
</BaseLayout>

<script is:inline define:vars={{ catMap }}>
  window.__CAT_MAP__ = catMap;
</script>
<script>
  import { initCategoryFilter } from '../../scripts/category-filter';
  initCategoryFilter(window.__CAT_MAP__);
</script>
