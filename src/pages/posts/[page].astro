---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BackToTop from '../../components/BackToTop.astro';
import { getAllPostsFromCollection, POSTS_PER_PAGE, getPostsPageData } from '../../data/content';
import PostCard from '../../components/PostCard.astro';

export async function getStaticPaths() {
  const allPosts = await getAllPostsFromCollection();
  const totalPages = Math.ceil(allPosts.length / POSTS_PER_PAGE);
  return Array.from({ length: totalPages - 1 }, (_, i) => ({
    params: { page: String(i + 2) },
    props: { page: i + 2, totalPages },
  }));
}

const { allPosts, projectMap, postsTagline, categories, catMap, totalPages } = await getPostsPageData();
const { page = 1 } = Astro.props;
const start = (page - 1) * POSTS_PER_PAGE;
const currentPosts = allPosts.slice(start, start + POSTS_PER_PAGE);

const coverColors = ['var(--blue)', 'var(--green)', 'var(--red)', 'var(--orange)'];

const prevPage = page > 1 ? (page === 2 ? '/posts' : `/posts/${page - 1}`) : null;
const nextPage = page < totalPages ? `/posts/${page + 1}` : null;
---

<BaseLayout title={page === 1 ? '文章 · ZEFX' : `文章 (第${page}页) · ZEFX`}>
  <Header />

  <div class="page-banner reveal">
    <h1>全部<span class="hl">文章</span></h1>
    <p class="page-desc">{allPosts.length} 篇手打文字,{postsTagline}</p>
  </div>

  <section class="section" style="padding-top:0">
    <div class="cats reveal">
      {categories.map(cat => (
        <button type="button" class={`cat-btn${cat.active ? ' on' : ''}`} aria-pressed={cat.active ? 'true' : 'false'} data-label={cat.label}>{cat.label} {cat.count}</button>
      ))}
    </div>

    <div class="posts-grid" id="posts-grid">
      {currentPosts.map((post, i) => (
        <PostCard post={post} projectMap={projectMap} color={coverColors[(start + i) % coverColors.length]} index={start + i} />
      ))}
    </div>

    {totalPages > 1 && (
      <nav class="pagination reveal">
        {prevPage && (
          <a class="page-btn" href={prevPage}>← 上一页</a>
        )}
        <span class="page-info mono">第 {page} 页 / 共 {totalPages} 页</span>
        {nextPage && (
          <a class="page-btn" href={nextPage}>下一页 →</a>
        )}
      </nav>
    )}
  </section>

  <Footer />
  <BackToTop />
</BaseLayout>

<style>
  @media (max-width: 1000px) {
    .posts-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .pagination { flex-wrap: wrap; gap: 12px; }
  }
</style>

<script define:vars={{ catMap }}>
  (function() {
    var buttons = document.querySelectorAll('.cat-btn');
    var grid = document.getElementById('posts-grid');
    if (!grid) return;
    var items = grid.querySelectorAll('.post-card');
    buttons.forEach(function(btn) {
      btn.addEventListener('click', function() {
        buttons.forEach(function(b) { b.classList.remove('on'); b.setAttribute('aria-pressed','false'); });
        btn.classList.add('on'); btn.setAttribute('aria-pressed','true');
        var label = btn.dataset.label;
        var en = Object.entries(catMap).find(function(v) { return v[1] === label; })?.[0] || '';
        history.replaceState(null, '', en ? '#' + en : window.location.pathname);
        items.forEach(function(item) {
          item.style.display = (label === '全部' || item.dataset.category === label) ? '' : 'none';
        });
        grid.style.setProperty('display', items.length > 0 ? 'grid' : 'none');
      });
    });
    var hash = window.location.hash.slice(1);
    if (hash) {
      var zhLabel = catMap[hash] || hash;
      var target = document.querySelector('.cat-btn[data-label="' + zhLabel + '"]');
      if (target) target.click();
    }
  })();
</script>
