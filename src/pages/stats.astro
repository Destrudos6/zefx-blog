    padding-bottom: 6px;
  }
  .gh-repo-more {
    flex: 0 0 auto;
    align-self: center;
    font-size: 11px;
    color: var(--red);
    text-decoration: underline;
    padding: 2px 4px;
    white-space: nowrap;
  }
  .gh-repo {
    flex: 0 0 170px; /* 固定宽度卡片，一行横排 */
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    border: var(--bd);
    background: var(--paper);
    padding: 8px 12px;
    text-decoration: none;
    transition: transform .15s, box-shadow .15s;
  }
  .gh-repo:hover {
    transform: translate(-2px, -2px);
    box-shadow: 3px 3px 0 var(--ink);
  }
  .gh-repo-name {
    font-size: 13px;
    font-weight: 700;
    color: var(--ink);
  }
  .gh-repo-stars {
    font-size: 10px;
    color: var(--orange);
  }
  .gh-repo-desc {
    font-size: 11.5px;
    color: var(--soft);
    line-height: 1.5;
    /* 描述最多 2 行，超出省略，保证卡片高度恒定 */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .gh-repo-empty {
    font-size: 12px;
    color: var(--soft);
  }

  /* 微信读书模块：书籍卡片/弹层等由 JS 动态创建（无 scoped 属性），样式必须全局生效 */
  .wr-stats { display: flex; flex-direction: column; gap: 14px; }
  .wr-tabs { display: flex; gap: 6px; flex-wrap: wrap; }
  .wr-tabs button {
    font-family: inherit;
    font-size: 12px;
    color: var(--soft);
    background: var(--paper);
    border: var(--bd);
    padding: 4px 12px;
    cursor: pointer;
    transition: background .15s, color .15s;
  }
  .wr-tabs button:hover { color: var(--ink); }
  .wr-tabs button.active {
    background: var(--red);
    color: var(--paper);
    border-color: var(--red);
  }
  .wr-cards {
