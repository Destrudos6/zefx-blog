---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BackToTop from '../components/BackToTop.astro';
import { getSiteData } from '../data/backblaze';
// 全局样式（热力图/仓库卡片/微信读书弹层由 JS 动态创建，需全局生效）
import '../styles/stats.css';

const siteData = await getSiteData();

const umami = siteData.site.umami;

// 用户名配置（数据在运行时通过 Pages Functions 获取）
// GitHub 用户名由 API 从环境变量 GITHUB_OWNER 读取，前端不依赖 site.json
const leetcodeUser = siteData.site.leetcode?.username || '';
---

<BaseLayout title="统计 · ZEFX">
  <Header />

  <div class="page-banner reveal">
    <h1>统<span class="hl">计</span></h1>
    <p class="page-desc">时间都花在了哪里？一些关于我自己的数据。</p>
  </div>

  <section class="section" style="padding-top:0">
    <!-- 模块网格 -->
    <div class="stats-grid reveal" style="--d:.1s">
      <!-- GitHub 贡献日历（客户端加载真实数据） -->
      <section class="stat-card">
        <div class="stat-card-head">
          <h2>GitHub <span class="hl">贡献日历</span></h2>
          <span class="mono stat-tag" id="gh-tag">加载中…</span>
        </div>
        <div class="gh-calendar" id="gh-calendar" aria-label="GitHub 贡献日历"></div>
        <div class="gh-legend mono">
          <span>少</span>
          <span class="gh-cell c0"></span>
          <span class="gh-cell c1"></span>
          <span class="gh-cell c2"></span>
          <span class="gh-cell c3"></span>
          <span class="gh-cell c4"></span>
          <span>多</span>
        </div>
        <!-- 公开仓库列表（客户端加载真实数据） -->
        <div class="gh-repos" id="gh-repos">
          <div class="gh-repos-head mono">公开仓库</div>
          <div class="gh-repos-list" id="gh-repos-list"></div>
        </div>
        <div class="stat-card-foot mono" id="gh-foot">GitHub</div>
      </section>

      <!-- 力扣（客户端加载真实数据） -->
      <section class="stat-card">
        <div class="stat-card-head">
          <h2>力<span class="hl">扣</span></h2>
          <span class="mono stat-tag" id="lc-tag">{leetcodeUser ? '加载中…' : '未配置用户名'}</span>
        </div>
        <div class="lc-total">
          <span class="lc-num" id="lc-solved">–</span>
          <small class="mono" id="lc-totalq">题已解</small>
        </div>
        <div class="lc-bars">
          <div class="lc-bar-row">
            <span class="lc-label mono">简单</span>
            <div class="lc-track"><div class="lc-fill lc-easy" id="lc-easy" style="width:0%"></div></div>
            <span class="mono lc-val" id="lc-easy-n">–</span>
          </div>
          <div class="lc-bar-row">
            <span class="lc-label mono">中等</span>
            <div class="lc-track"><div class="lc-fill lc-mid" id="lc-mid" style="width:0%"></div></div>
            <span class="mono lc-val" id="lc-mid-n">–</span>
          </div>
          <div class="lc-bar-row">
            <span class="lc-label mono">困难</span>
            <div class="lc-track"><div class="lc-fill lc-hard" id="lc-hard" style="width:0%"></div></div>
            <span class="mono lc-val" id="lc-hard-n">–</span>
          </div>
        </div>
        <div class="lc-calendar" id="lc-calendar" aria-label="LeetCode 提交日历"></div>
        <div class="stat-card-foot mono">数据源：LeetCode 官方 API</div>
      </section>

      <!-- 微信读书（客户端加载真实数据） -->
      <section class="stat-card stat-wide">
        <div class="stat-card-head">
          <h2>微信<span class="hl">读书</span></h2>
          <span class="mono stat-tag" id="wr-tag">加载中…</span>
        </div>

        <!-- 阅读统计：周/月/年/总 -->
        <div class="wr-stats">
          <div class="wr-tabs mono" id="wr-tabs">
            <button type="button" data-mode="weekly">本周</button>
            <button type="button" data-mode="monthly" class="active">本月</button>
            <button type="button" data-mode="annually">今年</button>
            <button type="button" data-mode="overall">总计</button>
          </div>
          <div class="wr-cards" id="wr-cards">
            <div class="wr-card">
              <div class="lbl">阅读天数</div>
              <div class="num" id="wr-days">–</div>
            </div>
            <div class="wr-card">
              <div class="lbl">阅读时长</div>
              <div class="num" id="wr-time">–</div>
            </div>
            <div class="wr-card">
              <div class="lbl">日均阅读</div>
              <div class="num" id="wr-avg">–</div>
            </div>
            <div class="wr-card">
              <div class="lbl">对比上期</div>
              <div class="num" id="wr-compare">–</div>
            </div>
          </div>
          <div class="wr-longest" id="wr-longest"></div>
        </div>

        <!-- 最近在读（优先级高于已读完，放在上方） -->
        <div class="wr-section">
          <div class="wr-section-head mono">最近在读</div>
          <div class="wr-recent" id="wr-recent"></div>
        </div>

        <!-- 已读完书架 -->
        <div class="wr-section">
          <div class="wr-section-head mono">已读完 · <span id="wr-finished-count">0</span> 本</div>
          <div class="wr-grid" id="wr-finished"></div>
        </div>

        <div class="stat-card-foot mono">数据源：微信读书官方 API</div>
      </section>

      <!-- 书籍详情弹层 -->
      <div class="wr-modal" id="wr-modal" hidden>
        <div class="wr-modal-mask" id="wr-modal-mask"></div>
        <div class="wr-modal-box" id="wr-modal-box"></div>
      </div>
    </div>

    <!-- Umami 子模块：内嵌浏览（置于页面最下方） -->
    {umami?.dashboardUrl && (
      <section class="umami-section reveal" style="--d:.15s">
        <div class="stat-card-head">
          <h2>Umami <span class="hl">访问统计</span></h2>
          <a class="mono umami-open" href={umami.dashboardUrl} target="_blank" rel="noopener noreferrer">在新窗口打开 ↗</a>
        </div>
        <div class="umami-frame-wrap">
          <iframe
            class="umami-frame"
            src={umami.dashboardUrl}
            title="Umami 访问统计"
            loading="lazy"
            referrerpolicy="no-referrer"
            allow="clipboard-write"
          ></iframe>
        </div>
      </section>
    )}
  </section>

  <Footer />
  <BackToTop />
</BaseLayout>

<script is:inline set:html={`window.__LEETCODE_USER__ = ${JSON.stringify(leetcodeUser)};`}></script>

<script>
  import { initGitHubStats, initLeetcodeStats } from '../scripts/stats-render';
  import { initWeread } from '../scripts/weread';
  (function () {
    var leetcodeUser = window.__LEETCODE_USER__ || '';
    // GitHub / 力扣渲染逻辑已抽离至 src/scripts/stats-render.ts
    initGitHubStats();
    initLeetcodeStats(leetcodeUser);

    // 微信读书（逻辑已抽离至 src/scripts/weread.ts）
    initWeread();
  })();
</script>

<style>
  /* 概览区 */
  .stats-overview {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-bottom: 40px;
  }
  .ov-item {
    border: var(--bd);
    background: var(--card);
    box-shadow: 4px 4px 0 var(--ink);
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .ov-num {
    font-family: var(--disp);
    font-weight: 900;
    font-size: clamp(34px, 4.5vw, 48px);
    line-height: 1;
    color: var(--red);
  }
  .ov-item small { font-size: 12px; color: var(--soft); }

  /* 模块网格 */
  .stats-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-bottom: 40px;
  }
  .stat-card {
    border: var(--bd);
    background: var(--card);
    box-shadow: 6px 6px 0 var(--ink);
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    min-width: 0;
  }
  .stat-wide { grid-column: 1 / -1; }
  .stat-card-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }
  .stat-card-head h2 {
    font-size: clamp(20px, 2.2vw, 26px);
    margin: 0;
  }
  .stat-tag {
    font-size: 11px;
    color: var(--red);
    border: var(--bd);
    padding: 2px 8px;
    white-space: nowrap;
  }
  .stat-card-foot {
    font-size: 11px;
    color: var(--soft);
    border-top: 2px dashed rgba(128,128,128,.25);
    padding-top: 12px;
  }

  /* 热力图（容器与图例是模板静态元素，保留 scoped；.gh-col/.gh-cell 等由 JS 动态创建，
     样式必须全局生效，见下方 <style is:global>） */
  .gh-calendar,
  .lc-calendar {
    display: flex;
    flex-direction: column;
    align-items: center; /* 日历内容居中，避免卡片内右侧大片留白 */
    gap: 6px;
    overflow-x: auto;
    padding-bottom: 6px;
  }
  .gh-legend {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 10px;
    color: var(--soft);
    justify-content: flex-end;
  }

  /* 小数字卡（微信读书） */
  .mini-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }
  .mini-item {
    border: var(--bd);
    background: var(--paper);
    padding: 14px 10px;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .mini-num {
    font-family: var(--disp);
    font-weight: 900;
    font-size: 28px;
    color: var(--green);
  }
  .mini-item small { font-size: 10px; color: var(--soft); }
  .stat-line { font-size: 13.5px; color: var(--soft); line-height: 1.7; }
  .stat-line.dim { color: var(--soft); opacity: .8; }

  /* 力扣 */
  .lc-total { display: flex; align-items: baseline; gap: 8px; }
  .lc-num {
    font-family: var(--disp);
    font-weight: 900;
    font-size: 44px;
    color: var(--orange);
  }
  .lc-total small { font-size: 12px; color: var(--soft); }
  .lc-bars { display: flex; flex-direction: column; gap: 8px; }
  .lc-bar-row {
    display: grid;
    grid-template-columns: 44px 1fr 36px;
    align-items: center;
    gap: 10px;
  }
  .lc-label { font-size: 11px; color: var(--soft); }
  .lc-track {
    height: 12px;
    background: var(--paper);
    border: var(--bd);
    overflow: hidden;
  }
  .lc-fill { height: 100%; transition: width .3s; }
  .lc-easy { background: var(--green); }
  .lc-mid { background: var(--orange); }
  .lc-hard { background: var(--red); }
  .lc-val { font-size: 11px; color: var(--soft); text-align: right; }

  /* Umami 内嵌 */
  .umami-section {
    border: var(--bd);
    background: var(--card);
    box-shadow: 6px 6px 0 var(--ink);
    padding: 24px;
    margin-bottom: 40px;
  }
  .umami-open {
    font-size: 12px;
    color: var(--red);
    text-decoration: underline;
  }
  .umami-frame-wrap {
    margin-top: 18px;
    border: var(--bd);
    box-shadow: 4px 4px 0 var(--ink);
    overflow: hidden;
  }
  .umami-frame {
    display: block;
    width: 100%;
    height: 480px;
    border: none;
    background: var(--paper);
  }

  /* 响应式 */
  @media (max-width: 1000px) {
    .stats-grid { grid-template-columns: 1fr; }
    .stat-wide { grid-column: 1; }
    /* 内容可能超宽需要横向滚动：居中会裁掉左侧，改为左对齐 */
    .gh-calendar,
    .lc-calendar { align-items: flex-start; }
  }
  @media (max-width: 640px) {
    .stats-overview { grid-template-columns: 1fr 1fr; }
    .umami-frame { height: 360px; }
  }
</style>

