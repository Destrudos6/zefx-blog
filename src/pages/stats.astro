---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BackToTop from '../components/BackToTop.astro';
import { getAllPostsFromCollection, getAllProjects } from '../data/content';
import { getSiteData, getAboutData } from '../data/backblaze';

const [allPosts, allProjects, siteData, aboutData] = await Promise.all([
  getAllPostsFromCollection(),
  getAllProjects(),
  getSiteData(),
  getAboutData(),
]);

const umami = siteData.site.umami;
const totalComments = allPosts.reduce((sum, p) => sum + (p.comments || 0), 0);
const stats = aboutData.stats;

// GitHub 贡献日历：示例数据（确定性伪随机，每次构建结果一致，后续替换为 API 数据）
const CONTRIB_MAX = 5;
const cells = Array.from({ length: 364 }, (_, i) => {
  const v = ((i * 2654435761) % 1000) / 1000; // 简单哈希，稳定分布
  const r = ((i * 97) % 13) / 12;             // 季节波动
  return v * (0.35 + r) * CONTRIB_MAX;
});

// 力扣难度分布（示例数据）
const leetcode = {
  total: 326,
  easy: 148,
  medium: 137,
  hard: 41,
  submissions: 1287,
};

// 微信读书（示例数据）
const weread = {
  days: 128,
  books: 42,
  hours: 156,
  recent: '《置身事内：中国政府与经济发展》',
};

// 按列展开贡献热力图（53 周 × 7 天）
const weeks = Array.from({ length: 53 }, (_, w) =>
  Array.from({ length: 7 }, (_, d) => cells[(w * 7 + d) % 364])
);

function cellClass(v: number): string {
  if (v <= 0) return 'c0';
  if (v < CONTRIB_MAX * 0.3) return 'c1';
  if (v < CONTRIB_MAX * 0.6) return 'c2';
  if (v < CONTRIB_MAX * 0.9) return 'c3';
  return 'c4';
}
---

<BaseLayout title="统计 · ZEFX">
  <Header />

  <div class="page-banner reveal">
    <h1>统<span class="hl">计</span></h1>
    <p class="page-desc">时间都花在了哪里？一些关于我自己的数据。</p>
  </div>

  <section class="section" style="padding-top:0">
    <!-- 概览区：真实数据 -->
    <div class="stats-overview reveal">
      <div class="ov-item">
        <div class="ov-num">{stats[0]?.count ?? allPosts.length}</div>
        <small class="mono">{stats[0]?.unit ?? '篇文章'}</small>
      </div>
      <div class="ov-item">
        <div class="ov-num">{allProjects.length}</div>
        <small class="mono">个项目</small>
      </div>
      <div class="ov-item">
        <div class="ov-num">{stats[1]?.count ?? 0}</div>
        <small class="mono">{stats[1]?.unit ?? '天网站运行'}</small>
      </div>
      <div class="ov-item">
        <div class="ov-num">{totalComments}</div>
        <small class="mono">条评论</small>
      </div>
    </div>

    <!-- 模块网格 -->
    <div class="stats-grid reveal" style="--d:.1s">
      <!-- GitHub 贡献日历 -->
      <section class="stat-card stat-wide">
        <div class="stat-card-head">
          <h2>GitHub <span class="hl">贡献日历</span></h2>
          <span class="mono stat-tag">示例数据 · API 待接入</span>
        </div>
        <div class="gh-calendar" aria-label="GitHub 贡献日历（示例）">
          {weeks.map(week => (
            <div class="gh-col">
              {week.map((v, d) => (
                <span class={`gh-cell ${cellClass(v)}`} title={`${Math.round(v)} contributions`} />
              ))}
            </div>
          ))}
        </div>
        <div class="gh-legend mono">
          <span>少</span>
          <span class="gh-cell c0"></span>
          <span class="gh-cell c1"></span>
          <span class="gh-cell c2"></span>
          <span class="gh-cell c3"></span>
          <span class="gh-cell c4"></span>
          <span>多</span>
        </div>
        <div class="stat-card-foot mono">
          <span>GitHub · {siteData.site.github.owner}/{siteData.site.github.repo}</span>
        </div>
      </section>

      <!-- 微信读书 -->
      <section class="stat-card">
        <div class="stat-card-head">
          <h2>微信<span class="hl">读书</span></h2>
          <span class="mono stat-tag">示例数据</span>
        </div>
        <div class="mini-stats">
          <div class="mini-item">
            <div class="mini-num">{weread.days}</div>
            <small class="mono">天阅读</small>
          </div>
          <div class="mini-item">
            <div class="mini-num">{weread.books}</div>
            <small class="mono">本读完</small>
          </div>
          <div class="mini-item">
            <div class="mini-num">{weread.hours}</div>
            <small class="mono">小时</small>
          </div>
        </div>
        <p class="stat-line">最近在读：{weread.recent}</p>
        <div class="stat-card-foot mono">数据源：微信读书 API</div>
      </section>

      <!-- 力扣 -->
      <section class="stat-card">
        <div class="stat-card-head">
          <h2>力<span class="hl">扣</span></h2>
          <span class="mono stat-tag">示例数据</span>
        </div>
        <div class="lc-total">
          <span class="lc-num">{leetcode.total}</span>
          <small class="mono">题已解</small>
        </div>
        <div class="lc-bars">
          <div class="lc-bar-row">
            <span class="lc-label mono">简单</span>
            <div class="lc-track"><div class="lc-fill lc-easy" style={`width:${Math.round(leetcode.easy / leetcode.total * 100)}%`}></div></div>
            <span class="mono lc-val">{leetcode.easy}</span>
          </div>
          <div class="lc-bar-row">
            <span class="lc-label mono">中等</span>
            <div class="lc-track"><div class="lc-fill lc-mid" style={`width:${Math.round(leetcode.medium / leetcode.total * 100)}%`}></div></div>
            <span class="mono lc-val">{leetcode.medium}</span>
          </div>
          <div class="lc-bar-row">
            <span class="lc-label mono">困难</span>
            <div class="lc-track"><div class="lc-fill lc-hard" style={`width:${Math.round(leetcode.hard / leetcode.total * 100)}%`}></div></div>
            <span class="mono lc-val">{leetcode.hard}</span>
          </div>
        </div>
        <p class="stat-line mono">累计提交 {leetcode.submissions} 次</p>
        <div class="stat-card-foot mono">数据源：LeetCode API</div>
      </section>

      <!-- 扩展占位 -->
      <section class="stat-card stat-placeholder">
        <div class="stat-card-head">
          <h2>更多<span class="hl">数据</span></h2>
        </div>
        <p class="stat-line">更多维度的统计数据正在接入中……</p>
        <p class="stat-line mono dim">例如：观影记录、音乐、运动、书签</p>
        <div class="stat-card-foot mono">敬请期待</div>
      </section>
    </div>

    <!-- Umami 子模块：内嵌浏览 -->
    {umami?.dashboardUrl && (
      <section class="umami-section reveal" style="--d:.15s">
        <div class="stat-card-head">
          <h2>Umami <span class="hl">访问统计</span></h2>
          <a class="mono umami-open" href={umami.dashboardUrl} target="_blank" rel="noopener noreferrer">在新窗口打开 ↗</a>
        </div>
        <div class="umami-frame-wrap">
          <iframe
            class="umami-frame"
            src={umami.dashboardUrl}
            title="Umami 访问统计"
            loading="lazy"
            referrerpolicy="no-referrer"
            allow="clipboard-write"
          ></iframe>
        </div>
      </section>
    )}

    <!-- 数据说明 -->
    <div class="stats-note reveal" style="--d:.2s">
      <h3 class="mono">数据说明</h3>
      <p>
        本页各模块数据来源不同：<b>概览区</b>来自本站内容（真实数据）；
        <b>GitHub / 微信读书 / 力扣</b>目前展示示例数据，待对应 API 接入后替换；
        <b>Umami</b> 为访问统计看板内嵌。数据源接入进度见各卡片标注。
      </p>
    </div>
  </section>

  <Footer />
  <BackToTop />
</BaseLayout>

<style>
  /* 概览区 */
  .stats-overview {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-bottom: 40px;
  }
  .ov-item {
    border: var(--bd);
    background: var(--card);
    box-shadow: 4px 4px 0 var(--ink);
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .ov-num {
    font-family: var(--disp);
    font-weight: 900;
    font-size: clamp(34px, 4.5vw, 48px);
    line-height: 1;
    color: var(--red);
  }
  .ov-item small { font-size: 12px; color: var(--soft); }

  /* 模块网格 */
  .stats-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-bottom: 40px;
  }
  .stat-card {
    border: var(--bd);
    background: var(--card);
    box-shadow: 6px 6px 0 var(--ink);
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    min-width: 0;
  }
  .stat-wide { grid-column: 1 / -1; }
  .stat-card-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }
  .stat-card-head h2 {
    font-size: clamp(20px, 2.2vw, 26px);
    margin: 0;
  }
  .stat-tag {
    font-size: 11px;
    color: var(--red);
    border: var(--bd);
    padding: 2px 8px;
    white-space: nowrap;
  }
  .stat-card-foot {
    font-size: 11px;
    color: var(--soft);
    border-top: 2px dashed rgba(128,128,128,.25);
    padding-top: 12px;
  }

  /* GitHub 贡献日历 */
  .gh-calendar {
    display: flex;
    gap: 3px;
    overflow-x: auto;
    padding-bottom: 6px;
  }
  .gh-col { display: flex; flex-direction: column; gap: 3px; }
  .gh-cell {
    width: 10px;
    height: 10px;
    border-radius: 2px;
    background: var(--paper);
    border: 1px solid rgba(128,128,128,.15);
  }
  .gh-cell.c0 { background: rgba(128,128,128,.12); border-color: transparent; }
  .gh-cell.c1 { background: #9be9a8; border-color: transparent; }
  .gh-cell.c2 { background: #40c463; border-color: transparent; }
  .gh-cell.c3 { background: #30a14e; border-color: transparent; }
  .gh-cell.c4 { background: #216e39; border-color: transparent; }
  .gh-legend {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 10px;
    color: var(--soft);
    justify-content: flex-end;
  }

  /* 小数字卡（微信读书） */
  .mini-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }
  .mini-item {
    border: var(--bd);
    background: var(--paper);
    padding: 14px 10px;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .mini-num {
    font-family: var(--disp);
    font-weight: 900;
    font-size: 28px;
    color: var(--green);
  }
  .mini-item small { font-size: 10px; color: var(--soft); }
  .stat-line { font-size: 13.5px; color: var(--soft); line-height: 1.7; }
  .stat-line.dim { color: var(--soft); opacity: .8; }

  /* 力扣 */
  .lc-total { display: flex; align-items: baseline; gap: 8px; }
  .lc-num {
    font-family: var(--disp);
    font-weight: 900;
    font-size: 44px;
    color: var(--orange);
  }
  .lc-total small { font-size: 12px; color: var(--soft); }
  .lc-bars { display: flex; flex-direction: column; gap: 8px; }
  .lc-bar-row {
    display: grid;
    grid-template-columns: 44px 1fr 36px;
    align-items: center;
    gap: 10px;
  }
  .lc-label { font-size: 11px; color: var(--soft); }
  .lc-track {
    height: 12px;
    background: var(--paper);
    border: var(--bd);
    overflow: hidden;
  }
  .lc-fill { height: 100%; transition: width .3s; }
  .lc-easy { background: var(--green); }
  .lc-mid { background: var(--orange); }
  .lc-hard { background: var(--red); }
  .lc-val { font-size: 11px; color: var(--soft); text-align: right; }

  /* 占位卡片 */
  .stat-placeholder {
    border-style: dashed;
    box-shadow: none;
    background: transparent;
  }

  /* Umami 内嵌 */
  .umami-section {
    border: var(--bd);
    background: var(--card);
    box-shadow: 6px 6px 0 var(--ink);
    padding: 24px;
    margin-bottom: 40px;
  }
  .umami-open {
    font-size: 12px;
    color: var(--red);
    text-decoration: underline;
  }
  .umami-frame-wrap {
    margin-top: 18px;
    border: var(--bd);
    box-shadow: 4px 4px 0 var(--ink);
    overflow: hidden;
  }
  .umami-frame {
    display: block;
    width: 100%;
    height: 480px;
    border: none;
    background: var(--paper);
  }

  /* 数据说明 */
  .stats-note {
    border: var(--bd);
    background: var(--card);
    box-shadow: 4px 4px 0 var(--ink);
    padding: 20px 24px;
  }
  .stats-note h3 { font-size: 12px; color: var(--red); margin-bottom: 8px; }
  .stats-note p { font-size: 13.5px; color: var(--soft); line-height: 1.8; }
  .stats-note b { color: var(--ink); }

  /* 响应式 */
  @media (max-width: 1000px) {
    .stats-grid { grid-template-columns: 1fr; }
    .stat-wide { grid-column: 1; }
  }
  @media (max-width: 640px) {
    .stats-overview { grid-template-columns: 1fr 1fr; }
    .umami-frame { height: 360px; }
  }
</style>
