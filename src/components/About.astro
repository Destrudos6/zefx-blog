---
import type { AboutData } from '../data/backblaze';
import { getSiteData } from '../data/backblaze';
import { getMediaUrl } from '../utils/media';

interface Props {
  data: AboutData;
  postCalendar?: Record<string, number>;
  heatmapYear?: number;
  heatmapMonth?: number;
}

const { data, postCalendar = {}, heatmapYear, heatmapMonth } = Astro.props;
const siteData = await getSiteData();
const avatarUrl = getMediaUrl(siteData.site.avatar || '/Avatar.png');
const hasHeatmap = Object.keys(postCalendar).length > 0;
---

<section class="about" id="about">
  <div class="section">
    <div class="about-cols">
      <div class="about-left">
        <div class="about-grid">
          <div class="ava reveal"><img src={avatarUrl} alt="头像" width="132" height="132" /></div>
          <div class="reveal" style="--d:.1s">
            <h2>关于站主</h2>
            <p class="bio">{data.bio}</p>
            <p class="facts">
              {data.facts.map(f => <><b>▸</b>{f}<br /></>)}
            </p>
          </div>
        </div>
        <div class="stats reveal" style="--d:.15s">
          {data.stats.map(s => (
            <div class="stat"><div class="num" data-count={s.count}>0</div><small>{s.unit}</small></div>
          ))}
        </div>
      </div>

      {hasHeatmap && (
        <div class="about-heatmap reveal" style="--d:.2s" data-calendar={JSON.stringify(postCalendar)} data-year={heatmapYear} data-month={heatmapMonth}>
          <h3 class="about-heatmap-title">发帖<span class="ah-hl">热力图</span></h3>
          <div class="about-heatmap-body" id="post-heatmap"></div>
          <p class="about-heatmap-note mono">近两月每日发帖数 · 颜色越深发帖越多</p>
        </div>
      )}
    </div>
  </div>
</section>

<script>
  import { renderMonthHeatmap } from '../scripts/heatmap';

  const box = document.getElementById('post-heatmap');
  if (box) {
    const host = box.closest('[data-calendar]');
    if (host) {
      let calendar = {};
      try { calendar = JSON.parse(host.dataset.calendar || '{}'); } catch { /* 忽略解析失败 */ }
      const max = Math.max(1, ...Object.values(calendar).map(v => Number(v) || 0));
      const year = Number(host.dataset.year) || new Date().getFullYear();
      const month = Number(host.dataset.month) || new Date().getMonth();
      renderMonthHeatmap(box, calendar, max, year, month, 2);
    }
  }
</script>

<style>
  .about-cols {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 48px;
    align-items: center;
  }
  .about-heatmap {
    max-width: 480px;
    padding-left: 48px;
    border-left: 2px dashed rgba(128,128,128,.4);
  }
  .about-heatmap-title {
    font-family: var(--serif);
    font-weight: 900;
    font-size: 22px;
    margin: 0 0 16px;
  }
  .ah-hl {
    background-image: linear-gradient(transparent 64%, var(--red) 64%);
  }
  .about-heatmap-note {
    font-size: 10.5px;
    opacity: .6;
    margin: 14px 0 0;
  }
  .about-heatmap-body {
    display: flex;
    gap: 36px;
    align-items: flex-start;
  }

  @media (max-width: 1000px) {
    .about-cols {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .about-heatmap {
      padding-left: 0;
      border-left: none;
      max-width: 100%;
    }
  }
</style>

<style is:global>
  /* 发帖热力图：格子由 JS 动态创建（无 Astro scoped 属性），样式必须全局生效。
     about 区块为深色背景（--ink），配色使用深色主题专用色阶。 */
  .about-heatmap .gh-month-block {
    flex-shrink: 0;
  }
  .about-heatmap .gh-head {
    display: flex;
    align-items: flex-end;
  }
  .about-heatmap .gh-labels-space {
    width: 36px;
    flex-shrink: 0;
  }
  .about-heatmap .gh-months {
    display: flex;
    gap: 4px;
  }
  .about-heatmap .gh-month {
    font-size: 13px;
    font-weight: 700;
    line-height: 1;
    color: var(--ink);
    white-space: nowrap;
    overflow: visible;
    text-align: center;
  }
  .about-heatmap .gh-body {
    display: flex;
    gap: 4px;
  }
  .about-heatmap .gh-labels {
    display: flex;
    flex-direction: column;
    gap: 4px;
    width: 36px;
    flex-shrink: 0;
  }
  .about-heatmap .gh-label {
    height: 14px;
    font-size: 12px;
    line-height: 14px;
    color: var(--ink);
    opacity: .75;
  }
  .about-heatmap .gh-cols {
    display: flex;
    gap: 4px;
  }
  .about-heatmap .gh-col {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  /* 色阶跟随主题：about 区块背景为 var(--card)（亮色=浅米白、暗色=深蓝黑），
     格子配色与其对比——亮色主题（浅背景）用深绿系，暗色主题（深背景）用亮绿系 */
  .about-heatmap {
    --hm-c0: rgba(31, 37, 55, .12);
    --hm-c1: #95d5b2;
    --hm-c2: #52b788;
    --hm-c3: #40916c;
    --hm-c4: #2d6a4f;
  }
  html[data-theme="dark"] .about-heatmap {
    --hm-c0: rgba(253, 250, 241, .14);
    --hm-c1: #0e4429;
    --hm-c2: #006d32;
    --hm-c3: #26a641;
    --hm-c4: #39d353;
  }
  .about-heatmap .gh-cell {
    width: 14px;
    height: 14px;
    border-radius: 3px;
    background: var(--hm-c0);
    border: 1px solid transparent;
    flex-shrink: 0;
  }
  .about-heatmap .gh-cell.c0 { background: var(--hm-c0); }
  .about-heatmap .gh-cell.c1 { background: var(--hm-c1); }
  .about-heatmap .gh-cell.c2 { background: var(--hm-c2); }
  .about-heatmap .gh-cell.c3 { background: var(--hm-c3); }
  .about-heatmap .gh-cell.c4 { background: var(--hm-c4); }

  /* 移动端适配：月度格子少，保持较大的格子尺寸，仅略微缩小并允许横向滚动 */
  @media (max-width: 640px) {
    .about-heatmap {
      max-width: 100%;
    }
    .about-heatmap-body {
      overflow-x: auto;
      padding-bottom: 6px;
    }
    .about-heatmap .gh-head,
    .about-heatmap .gh-body {
      gap: 3px;
    }
    .about-heatmap .gh-labels-space,
    .about-heatmap .gh-labels {
      width: 28px;
    }
    .about-heatmap .gh-months,
    .about-heatmap .gh-cols {
      gap: 3px;
    }
    .about-heatmap .gh-month {
      font-size: 12px;
    }
    .about-heatmap .gh-label {
      height: 12px;
      font-size: 11px;
      line-height: 12px;
    }
    .about-heatmap .gh-col {
      gap: 3px;
    }
    .about-heatmap .gh-cell {
      width: 12px;
      height: 12px;
      border-radius: 2.5px;
    }
  }
</style>
