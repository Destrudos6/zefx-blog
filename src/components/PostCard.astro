---
import Cover from './Cover.astro';
import { getMediaUrl, getPostCoverPath } from '../utils/media';
import type { Post, Project } from '../data/content';

interface Props {
  post: Post;
  projectMap: Record<string, Project>;
  color: string;
  index: number;
}

const { post, projectMap, color, index } = Astro.props;
// 文章封面缺失但关联项目时，回退到项目封面（统一规则见 getPostCoverPath）
const coverPath = getPostCoverPath(post, projectMap);
const coverImage = coverPath ? getMediaUrl(coverPath) : null;
---

<a class="post-card reveal" href={`/posts/${post.slug}`} style={`--ac:${post.categoryColor}; --cover-bg:${color}; ${post.categoryTextColor ? `--actext:${post.categoryTextColor}` : ''}`} data-category={post.category}>
  <Cover src={coverImage} alt={post.title} class="post-cover" icon="📸" label={`IMG_${String(index + 1).padStart(4, '0')}`} />
  <div class="post-body">
    <div class="post-meta-row">
      <span class="cat">{post.category}</span>
      {post.project && projectMap[post.project] && (
        <span class="project-tag" style={`--pc:${projectMap[post.project].coverColor}`}>{projectMap[post.project].title}</span>
      )}
      <time>{post.date}</time>
    </div>
    <h3><span class="hl-title">{post.title}</span></h3>
    <p>{post.excerpt}</p>
    <div class="post-foot">
      <span class="mono">{post.readTime} · <span data-comment-slug={post.slug}>{post.comments}</span> 评论</span>
      <span class="go">→</span>
    </div>
  </div>
</a>

<style>
  .post-card { text-decoration: none; color: inherit; }
  .post-card:hover .hl-title {
    text-decoration: underline;
    text-decoration-color: var(--lemon);
    text-decoration-thickness: .28em;
    text-underline-offset: .12em;
    text-decoration-skip-ink: auto;
  }
</style>
