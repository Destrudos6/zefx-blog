---
import { getSiteData } from '../data/backblaze';

const { giscus } = (await getSiteData()).site;
const origin = Astro.site?.origin || '';

function resolveTheme(path?: string): string {
  if (!path) return 'light';
  if (path.startsWith('http://') || path.startsWith('https://')) return path;
  if (path.startsWith('/')) return `${origin}${path}`;
  return path;
}

const themeLight = resolveTheme(giscus?.theme);
const themeDark = resolveTheme(giscus?.themeDark) || themeLight;
---

{giscus?.repo && giscus?.repoId && giscus?.categoryId && (
  <section class="giscus-section" id="giscus"
    data-theme-light={themeLight}
    data-theme-dark={themeDark}
  >
    <script is:inline data-giscus={JSON.stringify({
      repo: giscus.repo,
      repoId: giscus.repoId,
      category: giscus.category,
      categoryId: giscus.categoryId,
      mapping: giscus.mapping ?? 'pathname',
      strict: giscus.strict ?? '0',
      reactionsEnabled: giscus.reactionsEnabled ?? '1',
      inputPosition: giscus.inputPosition ?? 'top',
      lang: giscus.lang ?? 'zh-CN',
    })}>
      (function() {
        var cfg = JSON.parse(document.currentScript.dataset.giscus);
        var sec = document.currentScript.parentNode;
        var loaded = false;

        function loadGiscus() {
          if (loaded) return;
          loaded = true;

          var s = localStorage.getItem('theme');
          var isDark = s === 'dark' || (!s && matchMedia('(prefers-color-scheme: dark)').matches);
          var theme = isDark ? sec.dataset.themeDark : sec.dataset.themeLight;

          var g = document.createElement('script');
          g.src = 'https://giscus.app/client.js';
          g.setAttribute('data-repo', cfg.repo);
          g.setAttribute('data-repo-id', cfg.repoId);
          g.setAttribute('data-category', cfg.category);
          g.setAttribute('data-category-id', cfg.categoryId);
          g.setAttribute('data-mapping', cfg.mapping);
          g.setAttribute('data-strict', cfg.strict);
          g.setAttribute('data-reactions-enabled', cfg.reactionsEnabled);
          g.setAttribute('data-emit-metadata', '0');
          g.setAttribute('data-input-position', cfg.inputPosition);
          g.setAttribute('data-theme', theme);
          g.setAttribute('data-lang', cfg.lang);
          g.setAttribute('data-loading', 'lazy');
          g.crossOrigin = 'anonymous';
          g.async = true;

          sec.appendChild(g);
        }

        // 滚动到评论区附近才注入 client.js：评论区在页面底部，
        // 提前注入会在本地/受限网络下因 giscus.app 挂起拖住页面加载指示。
        if ('IntersectionObserver' in window) {
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (e) {
              if (e.isIntersecting) {
                loadGiscus();
                io.disconnect();
              }
            });
          }, { rootMargin: '200px 0px' });
          io.observe(sec);
        } else {
          loadGiscus();
        }
      })();
    </script>
  </section>
)}

<style>
  .giscus-section {
    max-width: 1200px;
    margin: 0 auto;
    padding: 48px 24px 0;
  }

  @media (max-width: 640px) {
    .giscus-section {
      padding: 32px 18px 0;
    }
  }
</style>

<script>
  const sec = document.getElementById('giscus');
  if (sec) {
    function syncGiscusTheme() {
      const iframe = document.querySelector('iframe.giscus-frame');
      if (!iframe) return;
      const theme = document.documentElement.dataset.theme === 'dark'
        ? sec.dataset.themeDark : sec.dataset.themeLight;
      if (!theme) return;
      iframe.contentWindow.postMessage(
        { giscus: { setConfig: { theme } } },
        'https://giscus.app'
      );
    }

    new MutationObserver((mutations) => {
      for (const m of mutations) {
        if (m.attributeName === 'data-theme') {
          syncGiscusTheme();
          return;
        }
      }
    }).observe(document.documentElement, { attributes: true });
  }
</script>
