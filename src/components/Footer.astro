---
import { getSiteData } from '../data/backblaze';

const siteData = await getSiteData();
const { description, copyright, footerNav, categories, elsewhere } = siteData.site;

const isExternal = (href: string) => /^https?:\/\//.test(href);

// 构建时间使用本地时区，避免 toISOString()（UTC）在国内显示成前一天
const now = new Date();
const pad = (n: number) => String(n).padStart(2, '0');
const buildDate = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}`;
---

<footer>
  <div class="f-ghost" aria-hidden="true">Focus on the essential.</div>
  <div class="f-cols">
    <div class="f-brand">
      <h4>{siteData.site.name}</h4>
      <p>{description}</p>
    </div>
    <div>
      <h4>导航</h4>
      <ul>
        {footerNav.map(item => <li><a href={item.href} target={isExternal(item.href) ? '_blank' : undefined} rel={isExternal(item.href) ? 'noopener noreferrer' : undefined}>{item.label}</a></li>)}
        <li><a href="/stats">统计</a></li>
      </ul>
    </div>
    <div>
      <h4>分类</h4>
      <ul>{categories.map(item => <li><a href={item.href} target={isExternal(item.href) ? '_blank' : undefined} rel={isExternal(item.href) ? 'noopener noreferrer' : undefined}>{item.label}</a></li>)}</ul>
    </div>
    <div>
      <h4>ELSEWHERE</h4>
      <ul>{elsewhere.map(item => <li><a href={item.href} target={isExternal(item.href) ? '_blank' : undefined} rel={isExternal(item.href) ? 'noopener noreferrer' : undefined}>{item.label}</a></li>)}</ul>
    </div>
  </div>
  <div class="f-bottom">
    <span>{copyright}</span>
    <span>构建时间 {buildDate}</span>
  </div>
</footer>
