---
import Cover from './Cover.astro';
import { getMediaUrl } from '../utils/media';
import type { ProjectLog } from '../data/content';

interface Props {
  title: string;
  status: 'active' | 'done' | 'pause';
  statusLabel: string;
  description: string;
  logs: ProjectLog[];
  tags: string[];
  coverImage?: string;
}

const { title, status, statusLabel, description, logs, tags, coverImage } = Astro.props;
const coverUrl = coverImage ? getMediaUrl(coverImage) : null;
// 标签最多显示 3 个，其余用 "+N" 汇总提示（防止标签过多把卡片拉高，也避免 CSS 截断切掉半个标签）
const MAX_TAGS = 3;
const shownTags = tags.slice(0, MAX_TAGS);
const hiddenTagCount = tags.length - shownTags.length;
---

<div class="project reveal">
  {coverUrl && (
    <Cover src={coverUrl} alt={title} class="project-cover" />
  )}
  <div class="project-head">
    <h3>{title}</h3>
    <span class={`project-status ${status}`}>{statusLabel}</span>
  </div>
  <p class="project-desc">{description}</p>
  <div class="project-updates">
    {logs.map(u => (
      <div class="p-update">
        <time>{u.date}</time>
        <p>{u.text}</p>
      </div>
    ))}
  </div>
  <div class="project-tags">
    {shownTags.map(t => (
      <span class="tag">{t}</span>
    ))}
    {hiddenTagCount > 0 && (
      <span class="tag tag-more">+{hiddenTagCount}</span>
    )}
  </div>
</div>
