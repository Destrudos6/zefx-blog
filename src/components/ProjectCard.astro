---
import { getMediaUrl } from '../utils/media';
import type { ProjectLog } from '../data/content';

interface Props {
  title: string;
  status: 'active' | 'done' | 'pause';
  statusLabel: string;
  description: string;
  logs: ProjectLog[];
  tags: string[];
  coverImage?: string;
}

const { title, status, statusLabel, description, logs, tags, coverImage } = Astro.props;
const coverUrl = coverImage ? getMediaUrl(coverImage) : null;
---

<div class="project reveal">
  {coverUrl && (
    <div class="project-cover">
      <img class="cover-img" src={coverUrl} alt={title} loading="lazy" decoding="async" width="1200" height="630" sizes="(max-width: 1000px) 100vw, 500px" />
    </div>
  )}
  <div class="project-head">
    <h3>{title}</h3>
    <span class={`project-status ${status}`}>{statusLabel}</span>
  </div>
  <p class="project-desc">{description}</p>
  <div class="project-updates">
    {logs.map(u => (
      <div class="p-update">
        <time>{u.date}</time>
        <p>{u.text}</p>
      </div>
    ))}
  </div>
  <div class="project-tags">
    {tags.map(t => (
      <span class="tag">{t}</span>
    ))}
  </div>
</div>
