---
import { getSiteData } from '../data/backblaze';
import { getMediaUrl } from '../utils/media';

const siteData = await getSiteData();
const { navItems, searchPlaceholder, umami } = siteData.site;
const currentPath = Astro.url.pathname;
const avatarUrl = getMediaUrl(siteData.site.avatar || '/Avatar.png');
const dashboardLabel = umami?.dashboardLabel || '统计';
---

<header>
  <div class="bar">
    <a class="logo" href="/">
      <div class="logo-mark"><img src={avatarUrl} alt="ZEFX" width="42" height="42" /></div>
      <span><b>{siteData.site.name}</b></span>
    </a>
    <nav class="nav-desktop">
      {navItems.map(item => (
        <a href={item.href} class={currentPath === item.href ? 'active' : ''}>{item.label}</a>
      ))}
      {umami?.dashboardUrl && (
        <a href={umami.dashboardUrl} target="_blank" rel="noopener noreferrer">{dashboardLabel}</a>
      )}
    </nav>
    <div class="bar-right">
      <form class="search-wrap" action="/search" method="GET">
        <input class="search" type="search" name="q" placeholder={searchPlaceholder} aria-label="搜索" autocomplete="off">
      </form>
      <a class="icon-btn search-icon-btn" href="/search" aria-label="搜索">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      </a>
      <button class="icon-btn" id="themeToggle" aria-label="切换夜间模式" aria-pressed="false">
        <span class="ic ic-sun">☀</span><span class="ic ic-moon">☾</span>
      </button>
      <a class="icon-btn rss-btn" href="/rss.xml" aria-label="RSS 订阅">RSS</a>
      <button class="hamburger" id="hamburger" aria-label="菜单" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
  <div class="mobile-nav" id="mobileNav" aria-hidden="true">
    <div class="mobile-search">
      <form action="/search" method="GET">
        <input type="search" name="q" placeholder={searchPlaceholder} aria-label="搜索" autocomplete="off">
      </form>
    </div>
    <nav>
      {navItems.map(item => (
        <a href={item.href} class={currentPath === item.href ? 'active' : ''}>{item.label}</a>
      ))}
      {umami?.dashboardUrl && (
        <a href={umami.dashboardUrl} target="_blank" rel="noopener noreferrer">{dashboardLabel}</a>
      )}
    </nav>
  </div>
</header>
