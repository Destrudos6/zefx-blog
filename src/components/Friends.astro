---
import type { FriendLink } from "../data/backblaze";
import { safeHost } from "../utils/url";

interface Props {
    links: FriendLink[];
    /** compact: 首页紧凑列表；detailed: 友链页详细卡片 + 交换友链 CTA */
    variant?: "compact" | "detailed";
    /** compact 版底部是否显示交换友链提示 */
    showExchange?: boolean;
}

const { links, variant = "compact", showExchange = false } = Astro.props;
---

{
    variant === "detailed" ? (
        <>
            <div class="flinks-detailed">
                {
                    links.map((f) => {
                        const host = safeHost(f.url);
                        return (
                            <a
                                class="fl-card reveal"
                                href={f.url || "#"}
                                target="_blank"
                                rel="noopener noreferrer"
                                style={`--c:${f.color}`}
                            >
                                <div class="fl-card-head">
                                    <span class="fl-dot" />
                                    {host && (
                                        <img
                                            class="fl-ico fl-card-ico"
                                            src={`https://${host}/favicon.ico`}
                                            alt=""
                                            width="18"
                                            height="18"
                                            decoding="async"
                                            loading="lazy"
                                            referrerpolicy="no-referrer"
                                            data-host={host}
                                        />
                                    )}
                                    <span class="fl-name">{f.name}</span>
                                </div>
                                <p class="fl-desc">{f.desc}</p>
                            </a>
                        );
                    })
                }
            </div>

            <div class="flink-cta reveal" style="margin-top:56px">
                <div class="flink-cta-inner">
                    <span class="cta-kicker mono">LINK EXCHANGE</span>
                    <h3>交换友链</h3>
                    <p>
                        要求很简单:不需要日更，不需要周更，你的更新频率按你的喜好就好。
                        记录自己的成长，记录你的观点，或是分享技术，分享你所看到的世界。只要你还在坚持写，欢迎交换友链
                    </p>
                    <p>
                        请在邮件里附上你的博客地址、名称和一句简介。不过，在发送邮件之前，请在你的博客中为我的网站先添加上友链。我会在
                        48 小时内回复并添加。
                    </p>
                    <a class="btn" href="mailto:hi@zefx.site">发邮件给我 <span>→</span></a>
                </div>
            </div>
        </>
    ) : (
        <section class="section" id="friends">
            <div class="sec-head reveal">
                <h2>友链 · 还在认真写博客的<span class="hl">友友</span></h2>
            </div>
            <div class="flinks reveal">
                {
                    links.map((f) => {
                        const host = safeHost(f.url);
                        return (
                            <a class="fl" href={f.url || "#"} style={`--c:${f.color}`}>
                                <i aria-hidden="true"></i>
                                {host && (
                                    <img
                                        class="fl-ico"
                                        src={`https://${host}/favicon.ico`}
                                        alt=""
                                        width="16"
                                        height="16"
                                        decoding="async"
                                        loading="lazy"
                                        referrerpolicy="no-referrer"
                                        data-host={host}
                                    />
                                )}
                                {f.name}
                            </a>
                        );
                    })
                }
            </div>
            {
                showExchange && (
                    <p class="flink-note reveal">
                        想交换友链?<a href="mailto:hi@zefx.site">发邮件给我 →</a>
                        (要求:还活着,还在写。)
                    </p>
                )
            }
        </section>
    )
}

<script>
  // favicon 加载成功隐藏占位圆点，失败隐藏图标（无第三方回退，保护访客隐私）
  document.querySelectorAll('.fl-ico').forEach((img) => {
    img.addEventListener('load', () => {
      const dot = img.previousElementSibling;
      if (dot) dot.style.display = 'none';
      img.classList.add('ok');
    });
    img.addEventListener('error', () => {
      img.style.display = 'none';
    });
  });
</script>

<style>
    /* ===== detailed 版（友链页）：详细卡片 + 交换友链 CTA ===== */
    .flinks-detailed {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 20px;
    }
    .fl-card {
        display: flex;
        flex-direction: column;
        gap: 12px;
        border: var(--bd);
        background: var(--card);
        padding: 24px;
        box-shadow: 6px 6px 0 var(--ink);
        transition:
            transform 0.28s,
            box-shadow 0.28s;
    }
    .fl-card:hover {
        transform: translate(-3px, -3px);
        box-shadow: 9px 9px 0 var(--red);
        background: var(--ink);
        color: var(--paper);
    }
    .fl-card-head {
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .fl-dot {
        width: 14px;
        height: 14px;
        border-radius: 50%;
        background: var(--c, var(--red));
        border: 2px solid var(--ink);
        flex-shrink: 0;
        display: inline-block;
    }
    .fl-card-ico {
        width: 18px !important;
        height: 18px !important;
    }
    .fl-name {
        font-weight: 700;
        font-size: 17px;
        font-family: var(--serif);
    }
    .fl-desc {
        font-size: 14px;
        color: var(--soft);
        line-height: 1.6;
    }
    .fl-card:hover .fl-desc {
        color: var(--paper);
        opacity: 0.8;
    }

    .flink-cta-inner {
        border: 3px dashed var(--ink);
        background: var(--card);
        padding: 56px 48px;
        max-width: 800px;
        margin: 0 auto;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
    }
    .cta-kicker {
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.2em;
        color: var(--red);
        margin-bottom: 18px;
    }
    .flink-cta-inner h3 {
        font-family: var(--serif);
        font-weight: 900;
        font-size: clamp(26px, 3.4vw, 38px);
        margin-bottom: 16px;
    }
    .flink-cta-inner p {
        font-size: 15.5px;
        color: var(--soft);
        margin-bottom: 16px;
        max-width: 32em;
        line-height: 1.7;
    }
    .flink-cta-inner p:last-of-type {
        margin-bottom: 32px;
    }
    .btn {
        display: inline-flex; align-items: center; gap: 10px; cursor: pointer;
        background: var(--red); color: #fff; border: var(--bd); padding: 12px 24px;
        font-weight: 700; font-size: 15px; box-shadow: 5px 5px 0 var(--ink);
        transition: transform .2s, box-shadow .2s; text-decoration: none;
    }
    .btn:hover { transform: translate(-2px,-2px); box-shadow: 7px 7px 0 var(--ink); }
</style>
